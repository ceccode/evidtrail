{
  "name": "@evidtrail/metrics",
  "version": "2.0.0",
  "description": "Deterministic provenance coverage and change signals (rapid retouch, trend, cohorts, outcomes) for evidtrail. AI provenance for git: declared at commit time, checked in CI, traceable to the agent session. Honest about what git cannot prove.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --dts",
    "dev": "tsup src/index.ts --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier -w ."
  },
  "dependencies": {
    "zod": "^3.22.4",
    "@evidtrail/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.5",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.0.0"
  },
  "keywords": [
    "ai",
    "ai-attribution",
    "ai-provenance",
    "ai-disclosure",
    "assisted-by",
    "provenance",
    "git",
    "ai-coding",
    "claude-code",
    "github-copilot",
    "cursor",
    "metrics"
  ],
  "author": "Francesco Falanga <falanga.fra@gmail.com>",
  "license": "MIT",
  "homepage": "https://ceccode.github.io/evidtrail/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ceccode/evidtrail.git",
    "directory": "packages/metrics"
  },
  "bugs": {
    "url": "https://github.com/ceccode/evidtrail/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
