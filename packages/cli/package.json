{
  "name": "@evidtrail/cli",
  "version": "1.3.0",
  "description": "Commit hook, DCO-style verify check, session trail and CI comments — CLI and GitHub Action. AI provenance for git: declared at commit time, checked in CI, traceable to the agent session. Honest about what git cannot prove.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "evidtrail": "dist/index.js"
  },
  "keywords": [
    "ai",
    "ai-attribution",
    "ai-provenance",
    "ai-disclosure",
    "assisted-by",
    "provenance",
    "git",
    "ai-coding",
    "claude-code",
    "github-copilot",
    "cursor",
    "cli",
    "github-actions"
  ],
  "author": "Francesco Falanga <falanga.fra@gmail.com>",
  "license": "MIT",
  "homepage": "https://ceccode.github.io/evidtrail/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ceccode/evidtrail.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ceccode/evidtrail/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts",
    "dev": "tsup src/index.ts --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier -w ."
  },
  "dependencies": {
    "commander": "^11.1.0",
    "zod": "^3.22.4",
    "@evidtrail/core": "workspace:*",
    "@evidtrail/metrics": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.5",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.0.0"
  }
}
