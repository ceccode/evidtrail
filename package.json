{
  "name": "evidtrail",
  "private": false,
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "AI provenance for git: declared at commit time, checked in CI, traceable to the agent session. Honest about what git cannot prove.",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel --filter ./packages/* run dev",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish-packages": "pnpm build && changeset publish",
    "release": "pnpm version-packages && pnpm install && pnpm publish-packages"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "ai",
    "provenance",
    "ai-provenance",
    "assisted-by",
    "ai-disclosure",
    "git"
  ],
  "author": "Francesco Falanga <falanga.fra@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/ceccode/evidtrail#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ceccode/evidtrail.git"
  },
  "bugs": {
    "url": "https://github.com/ceccode/evidtrail/issues"
  }
}
